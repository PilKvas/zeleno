<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Среда APNs. development — для сборок с development-профилем.
	     Для App Store / TestFlight Xcode подставляет production сам при
	     экспорте архива, менять руками не нужно. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
